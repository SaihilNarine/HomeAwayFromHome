@{
    ViewData["Title"] = "Home";
}

<section class="hero-section">
    <div class="hero-overlay"></div>

    <div class="hero-content">
        <div class="hero-logo">
            <img src="~/Image/Logo.jpeg" alt="Home Away From Home Logo" />
        </div>

        <span class="hero-tag">WELCOME TO HOME AWAY FROM HOME</span>

        <h1>
            Your comfort.<br />
            Your space.<br />
            <span>Your home.</span>
        </h1>

        <p>
            Experience a comfortable and welcoming stay where
            every detail is designed to make you feel at home.
        </p>

        <div class="hero-buttons">
            <a asp-controller="Properties"
               asp-action="Index"
               class="btn btn-primary btn-lg">
                Explore Our Property
            </a>

            <a href="#about"
               class="btn btn-outline-light btn-lg">
                Discover More
            </a>
        </div>
    </div>
</section>


<!-- INTRO -->
<section id="about" class="intro-section">
    <div class="container">
        <div class="row align-items-center">

            <div class="col-lg-6 mb-4 mb-lg-0">
                <span class="section-label">A PLACE TO BELONG</span>

                <h2>
                    More than a stay,
                    <span>it's a feeling.</span>
                </h2>

                <p>
                    Home Away From Home provides guests with a comfortable
                    and welcoming place to stay. Whether you are travelling
                    for business, relaxation, or a special occasion, our
                    goal is to make your stay simple, convenient and memorable.
                </p>

                <p>
                    From comfortable accommodation to useful amenities,
                    everything is designed with our guests in mind.
                </p>

                <a asp-controller="Properties"
                   asp-action="Index"
                   class="text-link">
                    Explore the property →
                </a>
            </div>

            <div class="col-lg-6">
                <div class="welcome-card">
                    <div class="welcome-card-content">
                        <span>HOME AWAY FROM HOME</span>
                        <h3>Comfort<br />meets convenience.</h3>
                        <p>
                            A welcoming space designed around your needs.
                        </p>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>


<!-- FEATURES -->
<section class="features-section">
    <div class="container">

        <div class="section-heading text-center">
            <span class="section-label">WHY STAY WITH US?</span>

            <h2>
                Everything you need
                <span>for a comfortable stay.</span>
            </h2>

            <p>
                We focus on the things that make a stay convenient,
                comfortable and enjoyable.
            </p>
        </div>

        <div class="row g-4 mt-3">

            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon">
                        🏠
                    </div>

                    <h3>Comfortable Space</h3>

                    <p>
                        Enjoy a welcoming property designed to give
                        you the comfort and privacy you need.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon">
                        ✨
                    </div>

                    <h3>Quality Amenities</h3>

                    <p>
                        Access useful amenities designed to make
                        your stay easier and more enjoyable.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon">
                        📅
                    </div>

                    <h3>Simple Booking</h3>

                    <p>
                        Submit a booking request and keep track
                        of your accommodation information with ease.
                    </p>
                </div>
            </div>

        </div>
    </div>
</section>


<!-- BOOKING -->
<section class="booking-section">
    <div class="container">
        <div class="booking-card">

            <div>
                <span class="section-label light">
                    READY FOR YOUR NEXT STAY?
                </span>

                <h2>
                    Find your home
                    <span>away from home.</span>
                </h2>

                <p>
                    Explore our property, check availability and
                    submit your booking request today.
                </p>
            </div>

            <div>
                <a asp-controller="Properties"
                   asp-action="Index"
                   class="btn btn-light btn-lg">
                    View Property
                </a>
            </div>

        </div>
    </div>
</section>


<!-- CUSTOMER EXPERIENCE -->
<section class="experience-section">
    <div class="container">

        <div class="text-center">
            <span class="section-label">YOUR STAY MATTERS</span>

            <h2>
                Built around
                <span>our guests.</span>
            </h2>

            <p class="experience-intro">
                From discovering the property to managing your booking,
                Home Away From Home gives guests a simple way to manage
                their stay.
            </p>
        </div>

        <div class="experience-grid">

            <div>
                <strong>01</strong>
                <h3>Discover</h3>
                <p>
                    Learn about our property, features and amenities.
                </p>
            </div>

            <div>
                <strong>02</strong>
                <h3>Request</h3>
                <p>
                    Submit a booking request for your preferred stay.
                </p>
            </div>

            <div>
                <strong>03</strong>
                <h3>Stay</h3>
                <p>
                    Enjoy a comfortable and welcoming experience.
                </p>
            </div>

            <div>
                <strong>04</strong>
                <h3>Review</h3>
                <p>
                    Share your experience after your stay.
                </p>
            </div>

        </div>

    </div>
</section>