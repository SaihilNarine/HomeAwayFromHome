@model IEnumerable<HomeAwayFromHome.Models.FinancialTransaction>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.PropertyID)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Property)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BookingID)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Booking)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TransactionType)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Amount)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TransactionDate)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.PropertyID)
            </td>
            <td>
                @Html.DisplayFor(model => item.Property)
            </td>
            <td>
                @Html.DisplayFor(model => item.BookingID)
            </td>
            <td>
                @Html.DisplayFor(model => item.Booking)
            </td>
            <td>
                @Html.DisplayFor(model => item.TransactionType)
            </td>
            <td>
                @Html.DisplayFor(model => item.Description)
            </td>
            <td>
                @Html.DisplayFor(model => item.Amount)
            </td>
            <td>
                @Html.DisplayFor(model => item.TransactionDate)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.FinancialTransactionID">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.FinancialTransactionID">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.FinancialTransactionID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
